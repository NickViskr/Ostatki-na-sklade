# Зависимости — ставятся заново внутри контейнера через npm ci
node_modules

# Служебные файлы git
.git
.gitignore

# Собранный фронтенд — пересобирается внутри контейнера (npm run build)
dist

# Документация — не нужна в образе, только увеличивает его размер
docs

# Секреты и локальные настройки окружения (пример оставляем — он безопасен)
.env
.env*
!.env.example

# Логи и системные файлы
*.log
.DS_Store

# Бэкенд Google Apps Script — разворачивается отдельно, в контейнере не нужен
Code.gs

# Служебный скрипт для патчей, в контейнер не нужен
patch.cjs
